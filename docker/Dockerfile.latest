FROM node:22-bullseye-slim AS wechat-group-sidecar-build

WORKDIR /build/wechat-group-sidecar
COPY channel/wechat_group/sidecar/package.json ./package.json
COPY channel/wechat_group/sidecar/package-lock.json ./package-lock.json
RUN printf '%s\n' 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm ci --omit=dev
COPY channel/wechat_group/sidecar/*.mjs ./
RUN npm test


FROM python:3.10-slim-bullseye

LABEL maintainer="foo@bar.com"
ARG TZ='Asia/Shanghai'

ARG CHATGPT_ON_WECHAT_VER
# Set to "false" to skip Playwright/Chromium and produce a smaller image
ARG INSTALL_BROWSER=true
# Comma-separated official capability packs: office,media,browser
ARG SKILL_CAPABILITY_PACKS=""
# Set to "true" to use China mirrors for apt / pip / playwright (faster in CN)
ARG USE_CN_MIRROR=false

ENV PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright
ENV BUILD_PREFIX=/app
ENV LIGHTAGENT_SKILL_CAPABILITY_PACKS=${SKILL_CAPABILITY_PACKS}

# Optionally switch apt and pip to China mirrors
RUN if [ "$USE_CN_MIRROR" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list; \
        pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/; \
    fi

COPY requirements.txt /tmp/lightagent-requirements/requirements.txt
COPY requirements-optional.txt /tmp/lightagent-requirements/requirements-optional.txt

# Stable dependencies stay ahead of application sources so regular code changes reuse this layer.
RUN printf '%s\n' 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update \
    && CAPABILITY_PACKAGES="" \
    && ENABLE_BROWSER="$INSTALL_BROWSER" \
    && for pack in $(echo "$SKILL_CAPABILITY_PACKS" | tr ',' ' '); do \
        case "$pack" in \
            office) CAPABILITY_PACKAGES="$CAPABILITY_PACKAGES libreoffice poppler-utils tesseract-ocr" ;; \
            media) CAPABILITY_PACKAGES="$CAPABILITY_PACKAGES ffmpeg" ;; \
            browser) ENABLE_BROWSER=true ;; \
            "") ;; \
            *) echo "Unknown SKILL_CAPABILITY_PACKS entry: $pack" >&2; exit 1 ;; \
        esac; \
    done \
    && apt-get install -y --no-install-recommends bash ffmpeg espeak libavcodec-extra libatomic1 libstdc++6 $CAPABILITY_PACKAGES \
    && /usr/local/bin/python -m pip install --no-cache --upgrade pip \
    && pip install --no-cache -r /tmp/lightagent-requirements/requirements.txt \
    && pip install --no-cache -r /tmp/lightagent-requirements/requirements-optional.txt \
    && if [ "$ENABLE_BROWSER" = "true" ]; then \
        apt-get install -y --no-install-recommends fonts-wqy-zenhei \
        && pip install --no-cache "playwright==1.52.0" \
        && python -m playwright install-deps chromium \
        && mkdir -p /app/ms-playwright \
        && if [ "$USE_CN_MIRROR" = "true" ]; then \
            PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright \
            python -m playwright install chromium; \
        else \
            python -m playwright install chromium; \
        fi; \
    fi \
    && rm -rf /var/lib/apt/lists/* /tmp/lightagent-requirements \
    && mkdir -p /home/agent/lightagent ${BUILD_PREFIX} \
    && groupadd -r agent \
    && useradd -r -g agent -s /bin/bash -d /home/agent agent \
    && chown -R agent:agent /home/agent ${BUILD_PREFIX} /usr/local/lib

COPY --from=wechat-group-sidecar-build /usr/local/bin/node /usr/local/bin/node
COPY --from=wechat-group-sidecar-build /usr/local/bin/npm /usr/local/bin/npm
COPY --from=wechat-group-sidecar-build /usr/local/bin/npx /usr/local/bin/npx
COPY --from=wechat-group-sidecar-build /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=wechat-group-sidecar-build --chown=agent:agent \
    /build/wechat-group-sidecar/node_modules \
    /app/channel/wechat_group/sidecar/node_modules

RUN cd /app/channel/wechat_group/sidecar \
    && node --version \
    && node -e "Promise.all([import('wechaty'), import('wechaty-puppet-wechat4u'), import('file-box')]).then(() => console.log('wechat-group-sidecar imports ok'))"

COPY --chown=agent:agent . ${BUILD_PREFIX}

RUN cd ${BUILD_PREFIX} \
    && pip install --no-cache --no-deps -e .

WORKDIR ${BUILD_PREFIX}

COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && chown agent:agent /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
